{
  "global": {
    "config_dir": "config",
    "database_file": "openhighway.sqlite3",
    "user_agent": "openhighways /1.0"
  },
  "master": {
    "default_steps": ["sync_sources"]
  },
  "api": {
    "host": "0.0.0.0",
    "port": 5000
  },
  "sources": {
    "national_highways": {
      "base_url": "https://public.highwaystrafficcameras.co.uk/cctvpublicaccess",
      "start_id": 0,
      "end_id": 99999,
      "workers": 15,
      "feature_server": "https://services-eu1.arcgis.com/mZXeBXkkZpekxjXT/arcgis/rest/services/Network_Model_Public_view2/FeatureServer/1/query",
      "request_timeout": 30,
      "request_delay": 0.1
    },
    "tfl": {
      "base_url": "https://api.tfl.gov.uk",
      "request_timeout": 15
    },
    "traffic_scotland": {
      "ftp_host": "ftp.traffic-scotland.co.uk",
      "camera_list": "cameraimages.csv",
      "image_directory": "current",
      "request_timeout": 30,
      "poll_interval_seconds": 600
    },
    "traffic_wales": {
      "base_url": "https://traffic.wales",
      "index_path": "/road-cameras",
      "workers": 8,
      "request_timeout": 20,
      "geocode_base_url": "https://nominatim.openstreetmap.org/search",
      "geocode_delay_seconds": 1.0,
      "overpass_base_url": "https://overpass-api.de/api/interpreter",
      "overpass_timeout": 180,
      "road_bbox": [51.29, -5.48, 53.44, -2.60],
      "road_snap_max_km": 5.0,
      "road_ref_overrides": {"A48M": "A48(M)"}
    },
    "northern_ireland": {
      "base_url": "https://www.trafficwatchni.com",
      "index_path": "/twni/cameras",
      "request_timeout": 20,
      "geocode_base_url": "https://nominatim.openstreetmap.org/search",
      "geocode_delay_seconds": 1.0,
      "overpass_base_url": "https://overpass-api.de/api/interpreter",
      "overpass_timeout": 180,
      "road_bbox": [54.0, -8.2, 55.4, -5.3],
      "road_snap_max_km": 5.0
    }
  },
  "vehicle_watcher": {
    "interval_seconds": 60,
    "workers": 10,
    "max_history_points": 240,
    "image_dir": "camera_images",
    "model_dir": "models",
    "input_size": 320,
    "confidence_threshold": 0.5,
    "nms_threshold": 0.5
  }
}
